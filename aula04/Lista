package aula04;

public class Lista {
	// Propriedades
	private No cabeca = null;
	
	// Métodos da classe
	public void inserir(int numero) {
			cabeca = new No(numero, null, cabeca); // referencia depois (direita) do igual é velha
			//cabeca (esquerda) é a nova cabeca
			if (cabeca.getProximo() != null) {
				cabeca.getProximo().setAnterior(cabeca);
			}
		}
		public void excluir(int numero) {
			// caso mt fácil: lista vazia
			if (cabeca == null) {
				return;
			}
			 // caso fácil: exclui o primeiro nó da lista
			if (cabeca.getNumero() == numero) {
				cabeca = cabeca.getProximo();
				if (cabeca != null) {
					cabeca.setAnterior(null);
					}
				return;
				}
			
			// procura do numero a ser excluido
			No ponteiro = cabeca;
			while ((ponteiro != null) && (ponteiro.getNumero() != numero)) {
				ponteiro = ponteiro.getProximo();
			}
			
			// caso dificil: o numero n foi encontrado
			if (ponteiro == null) {
				return;
			}
			
			// caso MUITO dificil: numero encontrado
			ponteiro.getAnterior().setProximo(ponteiro.getProximo());
			if (ponteiro.getProximo() != null) {
				ponteiro.getProximo().setAnterior(ponteiro.getAnterior());
			}
		}
		public void imprimir() {
			No ponteiro = cabeca;
			while (ponteiro != null) {
				System.out.println(ponteiro.getNumero());
				ponteiro = ponteiro.getProximo();
			}
		}
	}

